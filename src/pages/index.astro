---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Content from '~/components/widgets/Content.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import Stats from '~/components/widgets/Stats.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'Open Paper Reader — Research journal for computational science',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <Hero
    tagline="Volume 18 • Issue 02"
    actions={[
      {
        variant: 'primary',
        text: 'Read the latest issue',
        href: '#issue',
      },
      {
        variant: 'secondary',
        text: 'Submit a paper',
        href: '#submit',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1451187580459-43490279c0fa?auto=format&fit=crop&w=1200&q=80',
      alt: 'Scientific publication and research environment',
    }}
  >
    <Fragment slot="title">
      Research that advances the frontier of <span class="text-primary">human knowledge</span>.
    </Fragment>

    <Fragment slot="subtitle">
      An open, peer-reviewed journal for computational science, data systems, and applied discovery. We publish studies that
      are rigorous, transparent, and useful to researchers, practitioners, and teams building the next decade of evidence-based
      technology.
      <span class="mt-3 block text-sm uppercase tracking-[0.18em] text-primary dark:text-slate-300">
        Open access • Quarterly • Global readership
      </span>
    </Fragment>
  </Hero>

  <Stats
    stats={[
      { title: 'Articles published', amount: '1.2K' },
      { title: 'Citations', amount: '48.6K' },
      { title: 'Average review time', amount: '18d' },
      { title: 'Peer reviewers', amount: '640' },
    ]}
  />

  <Content
    id="issue"
    isReversed
    tagline="Featured issue"
    title="A journal designed for serious reading, not just surface-level discovery."
    items={[
      {
        title: 'Method-first scholarship',
        description:
          'Every paper is structured for reproducibility, methodological clarity, and meaningful comparison with prior work.',
      },
      {
        title: 'Research with impact',
        description:
          'We prioritize studies that sharpen the field, support real-world decisions, and improve the reliability of evidence.',
      },
      {
        title: 'Readable by experts and curious teams',
        description:
          'Our editorial system balances technical depth with accessible context, making complex ideas easier to evaluate and use.',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1531482615713-2afd69097998?auto=format&fit=crop&w=1400&q=80',
      alt: 'Scientists reviewing research in a modern lab',
    }}
  >
    <Fragment slot="content">
      <p class="text-lg leading-relaxed text-muted dark:text-slate-300">
        From foundational methods to applied systems, we publish work that helps researchers move from idea to evidence with
        clarity and rigor.
      </p>
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-slate-100/80 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <Content
    isAfterContent
    tagline="What we publish"
    title="Computational work that is transparent, robust, and ready for real-world use."
    items={[
      {
        title: 'AI and scientific systems',
        description: 'Research at the intersection of machine learning, evaluation, reliability, and measurable scientific progress.',
      },
      {
        title: 'Data infrastructures',
        description: 'Studies on pipelines, observability, data stewardship, and the systems behind trustworthy evidence generation.',
      },
      {
        title: 'Methodology and reproducibility',
        description: 'Clear, rigorous approaches to validation, benchmarking, and transparent reporting in technical research.',
      },
      {
        title: 'Applied research translation',
        description: 'Work that turns experimentation into practice, helping teams adopt evidence-based decisions with confidence.',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1516321318423-f06f85e504b3?auto=format&fit=crop&w=1400&q=80',
      alt: 'Data analysis desk with charts and research materials',
    }}
  >
    <Fragment slot="content">
      <p class="text-lg leading-relaxed text-muted dark:text-slate-300">
        We support scholarship that is technically honest, editorially strong, and useful to the communities shaping tomorrow’s
        tools and methods.
      </p>
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-slate-50/80 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <BlogLatestPosts
    title="Featured papers"
    information="Fresh work from our latest issue, curated for readers who want signal over noise and methodological depth over buzzwords."
  />

  <FAQs
    title="Frequently asked questions"
    subtitle="Everything researchers and teams need to know before submitting, reading, or collaborating with us."
    tagline="Journal guide"
    classes={{ container: 'max-w-6xl' }}
    items={[
      {
        title: 'Who is the journal for?',
        description:
          'Open Paper Reader is designed for researchers, engineers, and interdisciplinary teams working on computational, data-driven, and applied scientific problems.',
      },
      {
        title: 'How are submissions reviewed?',
        description:
          'We use a double-blind editorial review process with methodological scrutiny, data-quality checks, and clear reviewer feedback to improve the final manuscript.',
      },
      {
        title: 'Do you publish open access?',
        description:
          'Yes. We operate as an open-access publication model so findings remain discoverable, citable, and useful to the broader research community.',
      },
      {
        title: 'Can teams from industry contribute?',
        description:
          'Absolutely. We welcome applied research, systems papers, and work that turns technical insight into reproducible evidence with real operational value.',
      },
      {
        title: 'What makes the editorial approach different?',
        description:
          'We focus on clarity, rigor, and context—publishing work that is technically strong, well explained, and easy to evaluate in practice.',
      },
    ]}
  />

  <CallToAction
    id="submit"
    actions={[
      {
        variant: 'primary',
        text: 'Submit a paper',
        href: '#',
      },
      {
        variant: 'secondary',
        text: 'Browse archive',
        href: '#issue',
      },
    ]}
  >
    <Fragment slot="title">
      Build the next chapter of <span class="sm:whitespace-nowrap">evidence-driven research</span>
    </Fragment>

    <Fragment slot="subtitle">
      Share work that matters, improves the field, and reaches readers who value rigor, clarity, and relevance.
    </Fragment>
  </CallToAction>
</Layout>
