---
// Font family is provided by Astro's native Fonts API (see `fonts` in
// astro.config.ts and <Font /> in Layout.astro), exposed as `--font-inter`.
// To switch typefaces, change the `fonts` entry and repoint `--aw-font-*` below.

// 'DM Sans'
// Nunito
// Dosis
// Outfit
// Roboto
// Literata
// 'IBM Plex Sans'
// Karla
// Poppins
// 'Fira Sans'
// 'Libre Franklin'
// Inconsolata
// Raleway
// Oswald
// 'Space Grotesk'
// Urbanist
---

<style is:inline>
  :root {
    --aw-font-sans: var(--font-sans);
    --aw-font-serif: var(--font-serif-display);
    --aw-font-heading: var(--font-serif-display);

    --aw-color-primary: rgb(26 46 93);      /* cobalto institucional */
    --aw-color-secondary: rgb(80 32 48);    /* burdeos / académico */
    --aw-color-accent: rgb(26 46 93);

    --aw-color-text-heading: rgb(17 24 39);
    --aw-color-text-default: rgb(17 24 39);
    --aw-color-text-muted: rgb(17 24 39 / 0.68);
    --aw-color-bg-page: rgb(250 250 248);

    --aw-color-bg-page-dark: rgb(21 25 31);
  }

  .dark {
    --aw-font-sans: var(--font-sans);
    --aw-font-serif: var(--font-serif-display);
    --aw-font-heading: var(--font-serif-display);

    --aw-color-primary: rgb(148 163 184);
    --aw-color-secondary: rgb(203 213 225);

    --aw-color-text-heading: rgb(241 245 249);
    --aw-color-text-default: rgb(203 213 225);
    --aw-color-text-muted: rgb(148 163 184 / 0.82);
    --aw-color-bg-page: rgb(18 22 27);
  }
</style>
